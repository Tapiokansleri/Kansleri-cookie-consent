msgid "Manage cookies"
msgstr "Hallitse evästeitä"

#: includes/class-admin.php
msgid "You can also add a link to open cookie settings anywhere (e.g. footer) using this shortcode:"
msgstr "Voit myös lisätä linkin evästeasetusten avaamiseen minne tahansa (esim. alatunnisteeseen) tällä lyhytkoodilla:"

